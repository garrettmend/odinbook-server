# Server
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Prisma (Postgres)
# Format: postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/odinbook?schema=public"

# Cloudinary (optional, required for /api/uploads/avatar)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
